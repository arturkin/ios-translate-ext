<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS Safari Web Extension entitlements. On macOS the appex is sandboxed, so it
  MUST declare the outgoing-network entitlement or every API call (Azure, MyMemory,
  Wiktionary, BÍN) fails silently. No App Group here — the "minimal enabler" macOS
  build reads the Azure key from the baked-in xcconfig and stores toggles locally.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
